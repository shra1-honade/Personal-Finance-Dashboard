# Copy to .env.local and fill in. Never commit .env.local.

# Plaid keys: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake banks, test login user_good / pass_good) or production (your real banks)
PLAID_ENV=sandbox
# Only needed for OAuth banks in production (e.g. Chase). Must also be registered in the Plaid dashboard.
# PLAID_REDIRECT_URI=http://localhost:3000/oauth

# Where the SQLite database lives (holds bank access tokens — keep it private).
# DATABASE_PATH=./data/finance.db

# Strongly recommended if the app is reachable from other machines.
# APP_PASSWORD=
